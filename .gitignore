# Project-local MCP wiring — varies by developer (npx vs local dist vs published).
# Each contributor crafts their own; e.g. for local dev:
#   { "mcpServers": { "vibegraph": { "command": "node",
#       "args": ["packages/cli/dist/bin.js", "mcp"] } } }
# Or once published to npm:
#   { "mcpServers": { "vibegraph": { "command": "npx",
#       "args": ["-y", "@codearch/cli", "mcp"] } } }
.mcp.json
# …but the plugin ships its own .mcp.json (the MCP-server declaration) — must be tracked.
!packages/plugin/.mcp.json

# fire-rate experiment output (scripts/fire-rate.mjs)
.fire-rate/
