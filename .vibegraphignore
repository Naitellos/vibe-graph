# Standalone runnable examples have their own architecture and setup. They are
# product demos, not subsystems of the vibe-graph monorepo itself.
/examples/

# Repo-level test/tooling infra — not product subsystems, so excluded from the
# architecture graph (otherwise they surface as low-severity `unowned` drift).
# Leading slash anchors to the repo root so packages/*/test/** stays owned by
# its package's subsystem match glob. These remain fully run by vitest — this
# file only scopes vibe-graph's own scan, not the test runner.
/test/
/docs/dogfooding/
/scripts/
/vitest.config.ts

# fire-rate experiment output — clones of foreign repos land here. Ignored by git
# too, but the scan reads THIS file, not .gitignore, so without this line a run
# would pull ten other codebases into vibe-graph's own dogfood graph.
/.fire-rate/
