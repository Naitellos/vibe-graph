{
  "name": "@codearch/cli",
  "version": "0.1.4",
  "description": "Graph-based vibe coding cockpit and MCP context provider for TypeScript codebases.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Naitellos/vibe-graph.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Naitellos/vibe-graph#readme",
  "bugs": "https://github.com/Naitellos/vibe-graph/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vibe-graph": "./dist/bin.js",
    "codearch": "./dist/bin.js"
  },
  "files": ["dist", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "pnpm -w exec vitest run --passWithNoTests --minWorkers=1 --maxWorkers=2 packages/cli"
  },
  "dependencies": {
    "@clack/prompts": "~0.7.0",
    "chokidar": "~4.0.0",
    "citty": "~0.1.0",
    "ignore": "~6.0.0",
    "open": "~10.1.0",
    "picomatch": "~4.0.7",
    "pino": "~9.5.0",
    "pino-pretty": "~13.0.0",
    "tinyglobby": "~0.2.17",
    "typescript": "~5.6.0",
    "ws": "~8.21.0",
    "yaml": "~2.8.3",
    "zod": "~4.0.0"
  },
  "devDependencies": {
    "@types/node": "~22.10.0",
    "@types/ws": "~8.5.0",
    "@codearch/core": "workspace:*",
    "@codearch/mcp": "workspace:*",
    "tsup": "~8.5.1",
    "typescript": "~5.6.0"
  }
}
